# Copy to .env and fill in. NEVER commit .env.

# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1

# Database — local docker-compose default shown; use your Neon/Supabase
# DATABASE_URL in production (Render provides it automatically).
# Matches docker-compose.yml, which maps host port 5433 -> container 5432
# (5432 is often taken by a locally installed Postgres).
DATABASE_URL=postgres://pyarena:pyarena@localhost:5433/pyarena
POSTGRES_DB=pyarena
POSTGRES_USER=pyarena
POSTGRES_PASSWORD=pyarena

# CORS / CSRF — comma-separated, no trailing slash
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# JWT lifetimes in seconds (900 = 15 min access, 604800 = 7 days refresh)
JWT_ACCESS_TOKEN_LIFETIME=900
JWT_REFRESH_TOKEN_LIFETIME=604800

# DRF throttling rates (used on login/submit endpoints)
THROTTLE_ANON_RATE=100/hour
THROTTLE_USER_RATE=1000/hour
THROTTLE_LOGIN_RATE=10/min

# Email backend (console prints to terminal; use SMTP/SendGrid in prod)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Email via Resend SMTP (prod): https://resend.com API key as password
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.resend.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=resend
# EMAIL_HOST_PASSWORD=re_xxxxxxxxxxxx
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=PyArena <noreply@yourdomain.com>

# Roll number regex (9-digit enrollment OR division+roll like BX123)
# ROLL_NO_REGEX=^(\d{9}|[A-Za-z]{2}\d{1,3})$
